<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cs2trader.collect</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>@UV@ run cs2 collect run --kinds asks,bids,skinport,waxpeer --host mac; @UV@ run cs2 collect pull --cf-only; @UV@ run cs2 collect run --kinds sales --host mac</string>
    </array>
    <!-- Sales run last: the poll takes minutes and must not delay the hourly price snapshots. -->
    <key>WorkingDirectory</key>
    <string>@REPO@</string>
    <!-- StartCalendarInterval, unlike StartInterval, fires a missed run once after wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>47</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>@REPO@/data/logs/collect-mac.log</string>
    <key>StandardErrorPath</key>
    <string>@REPO@/data/logs/collect-mac.log</string>
</dict>
</plist>
